# Cava Configuration - Nord Theme (Coerente con Kitty)
# ~/.config/cava/config

[general]
# Modalità: nonportable (sincronizzato con musica) o portatile
mode = normal
framerate = 60
bars = 0
bar_width = 2
bar_spacing = 1

# Altezza barre (in percentuale del terminale)
bar_height = 32

# Risposta dell'equalizzatore
sensitivity = 100
autosens = 1
overshoot = 20

# Metodo di input
method = pulse
source = auto

# Smoothing
noise_reduction = 77
monstercat = 0
waves = 0
gravity = 100
integral = 77
fft_size = 2048

[output]
# Metodo di output (ncurses per terminale)
method = ncurses

# Orientamento
orientation = bottom

# Reverse mode per effetto specchio
reverse = 0

[color]
# Tema Nord Coerente
gradient = 1
gradient_count = 6

# Colori Nord (dal più scuro al più chiaro - dal basso verso l'alto)
gradient_color_1 = '#2E3440'   # nord0 - polarnight0 (sfondo)
gradient_color_2 = '#3B4252'   # nord1 - polarnight1
gradient_color_3 = '#434C5E'   # nord2 - polarnight2
gradient_color_4 = '#4C566A'   # nord3 - polarnight3
gradient_color_5 = '#81A1C1'   # nord9 - frost2 (azzurro medio)
gradient_color_6 = '#88C0D0'   # nord7 - frost3 (azzurro brillante)
gradient_color_7 = '#8FBCBB'   # nord8 - frost4 (ciano/verde acqua)
gradient_color_8 = '#D8DEE9'   # nord4 - snowstorm (bianco sporco)

[smoothing]
# Integrazione per smoothing
integral = 77
monstercat = 0
waves = 0
gravity = 100
