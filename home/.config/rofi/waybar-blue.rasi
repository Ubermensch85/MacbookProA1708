/*
** Nord Electric Rofi Theme - Aligned with Top Waybar
*/

* {
    background-color:     transparent;
    text-color:           #ECEFF4;
    font:                 "JetBrainsMono Nerd Font Bold 10";
}

window {
    anchor:     north;
    location:   north west;
    width:      42%;
    height:     34;
    padding:    0;
    children:   [ horibox ];
    y-offset:   46px;
    x-offset:   6px;
    background-color: #2E3440F0;
    border: 1px;
    border-color: #00A8FF;
    border-radius: 12px;
}

horibox {
    orientation: horizontal;
    children:   [ prompt, entry, listview ];
    background-color: transparent;
}

entry {
    expand:     false;
    width:      8em;
    padding:    8 0 0 8;
    text-color: #ECEFF4;
    background-color: transparent;
}

listview {
    layout:     horizontal;
    spacing:    12px;
    lines:      50;
    padding:    8 0 0;
    background-color: transparent;
}

element {
    padding: 0 8px;
    background-color: transparent;
    border-radius: 6px;
}

element selected {
    text-color:       #2E3440;
    background-color: #00A8FF;
}

element-text, element-icon {
    background-color: inherit;
    text-color:       inherit;
    highlight:        bold;
}

prompt {
    background-color: #00A8FF;
    text-color:       #2E3440;
    padding:          8 12 0 12;
    font:             "JetBrainsMono Nerd Font Bold 10";
}
