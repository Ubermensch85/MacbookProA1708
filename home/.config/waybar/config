{
    "name": "topbar",
    "layer": "top",
    "position": "top",
    "height": 37,
    "spacing": 5,
    "margin-top": 3,
    "margin-left": 3,
    "margin-right": 3,
    "reload_style_on_change": true,

    "modules-left": [
        "custom/arch",
        "custom/pacman",
        "disk",
        "cpu",
        "memory",
        "custom/weather"
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "temperature",
        "custom/gammastep",
        "backlight",
        "pulseaudio",
        "battery",
        "network",
        "tray",
        "clock"
    ],

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch workspace e-1",
        "on-scroll-down": "hyprctl dispatch workspace e+1",
        "format-icons": {
            "1": "<span font='DejaVu Serif 11'>Ⅰ</span>",
            "2": "<span font='DejaVu Serif 11'>Ⅱ</span>",
            "3": "<span font='DejaVu Serif 11'>Ⅲ</span>",
            "4": "<span font='DejaVu Serif 11'>Ⅳ</span>",
            "5": "<span font='DejaVu Serif 11'>Ⅴ</span>",
            "6": "<span font='DejaVu Serif 11'>Ⅵ</span>",
            "7": "<span font='DejaVu Serif 11'>Ⅶ</span>",
            "8": "<span font='DejaVu Serif 11'>Ⅷ</span>",
            "9": "<span font='DejaVu Serif 11'>Ⅸ</span>",
            "10": "<span font='DejaVu Serif 11'>Ⅹ</span>"
        }
    },

    "custom/arch": {
        "format": " <span size='x-large'>󰣇</span> ",
        "tooltip": "Clicca per system info",
        "on-click": "exec ~/.config/waybar/arch-script.sh"
    },

    "custom/pacman": {
        "format": "<span size='large'>󰮯</span>  {}",
        "interval": 1800,
        "exec": "checkupdates 2>/dev/null | wc -l | tr -d '\\n' || echo 0",
        "exec-if": "which checkupdates",
        "on-click": "kitty --title fly-foot-write /home/ubermensch/.config/waybar/scripts/update_system.sh",
        "signal": 8
    },

    "disk": {
        "interval": 30,
        "format": "󰋊  {percentage_used}%",
        "tooltip-format": "Disco: {used} / {total} ({percentage_used}%)",
        "path": "/",
        "on-click": "xdg-open /"
    },

    "cpu": {
        "format": "  {usage}%",
        "tooltip": true,
        "on-click": "kitty --title fly-foot-tiled -e htop"
    },

    "memory": {
        "format": "󰘚  {}%",
        "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G ({percentage}%)"
    },

    "custom/weather": {
        "format": "{}",
        "tooltip": true,
        "interval": 1800,
        "exec": "~/.config/waybar/script/weather.sh",
        "return-type": "json",
        "on-click": "pkill -RTMIN+10 waybar",
        "signal": 10
    },

    "temperature": {
        "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        "format": "  {temperatureC}°C",
        "tooltip-format": "Temperatura CPU: {temperatureC}°C"
    },

    "custom/gammastep": {
        "format": "{}",
        "return-type": "json",
        "interval": 60,
        "exec": "$HOME/scripts/gammastep.sh",
        "on-click": "bash $HOME/scripts/gammastep.sh toggle",
        "signal": 9
    },

    "backlight": {
        "format": "{icon}  {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "tooltip-format": "Luminosità: {percent}%",
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "pulseaudio": {
        "scroll-step": 5,
        "format": "{icon}  {volume}%",
        "format-bluetooth": "{icon}  {volume}%",
        "format-muted": "󰝟 ",
        "format-bluetooth-muted": "󰝟",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol",
        "on-click-right": "pamixer -t",
        "tooltip-format": "Volume: {volume}%"
    },

    "battery": {
        "states": {
            "warning": 18,
            "critical": 5
        },
        "format": "{icon}  {capacity}%",
        "format-charging": "  {capacity}%",
        "format-plugged": "  {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },

    "network": {
        "format-wifi": "󰤨 ",
        "format-ethernet": "󰈀 ",
        "format-disconnected": "󰤮 ",
        "format-linked": "󰤨 ",
        "format": "󰤨 ",
        "tooltip-format-wifi": "WiFi: {essid}\nSegnale: {signalStrength}%\nIP: {ipaddr}",
        "tooltip-format-ethernet": "Ethernet: {ifname}\nIP: {ipaddr}",
        "tooltip-format-disconnected": "Nessuna connessione di rete",
        "on-click": "networkmanager_dmenu"
    },

    "tray": {
        "spacing": 8
    },

    "clock": {
        "format": "  {:%H:%M}",
        "format-alt": "{:%d-%m-%Y}",
        "interval": 1,
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#00A8FF'><b>{}</b></span>",
                "days": "<span color='#ECEFF4'><b>{}</b></span>",
                "weekdays": "<span color='#88C0D0'><b>{}</b></span>",
                "today": "<span color='#00BFFF'><b><u>{}</u></b></span>"
            }
        }
    }
}
